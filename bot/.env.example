# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# ID канала для отправки уведомлений (напр. @mychannel или -1001234567890)
CHANNEL_ID=@your_channel

# ID личных чатов через запятую (для WebApp кнопок, web_app не работает в каналах)
# Узнать chat_id: напишите боту /start, затем打开 https://api.telegram.org/bot<TOKEN>/getUpdates
PRIVATE_CHAT_IDS=

# Интервал проверки в миллисекундах (по умолчанию 60 секунд)
POLL_INTERVAL=86400000

# Адрес контракта для отслеживания (опционально, пусто = все предложения сообществ TON)
DAO_ADDRESS=

# URL WebApp (для кнопки "Открыть в приложении" в личных чатах)
# Настроить через BotFather: /newapp
WEBAPP_URL=https://t.me/gradosphera_vote_bot/vote

# Адрес API (по умолчанию api.ton.vote)
API_BASE=https://api.ton.vote

# SOCKS5 прокси
PROXY=socks5://127.0.0.1:9150

# Веб-порт для health-check (0 = отключено)
PORT=3000

# Логирование (true/false)
DEBUG=false
