# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# ID канала для отправки уведомлений (напр. @mychannel или -1001234567890)
CHANNEL_ID=@your_channel

# ID личных чатов через запятую (для WebApp кнопок, web_app не работает в каналах)
# Узнать chat_id: напишите боту /start, затем: https://api.telegram.org/bot<TOKEN>/getUpdates
PRIVATE_CHAT_IDS=

# Интервал проверки в миллисекундах (по умолчанию 60 секунд)
POLL_INTERVAL=86400000

# Адрес контракта (ДАО или предложения) для отслеживания, через запятую для нескольких.
# Пусто = все предложения сообществ TON
DAO_ADDRESS=

# Публиковать последнее активное голосование ДАО при первом запуске (true/false)
SEND_LATEST=false

# URL WebApp (для кнопки "Открыть в приложении" в личных чатах)
# Настроить через BotFather: /newapp
WEBAPP_URL=https://t.me/gradosphera_vote_bot/vote

# Адрес API (по умолчанию api.ton.vote)
API_BASE=https://api.ton.vote

# Хост Telegram Bot API. Пусто = https://api.telegram.org (прямое подключение).
# Если Telegram заблокирован в сети — ваш Cloudflare Worker-релей (см. bot/cf-api-relay/ и README):
# TELEGRAM_API_BASE=https://blago-vote-tg-api-relay.<имя-сабдомена>.workers.dev

# SOCKS5 egress-прокси. Задаётся адрес gost/WireGuard-шлюза.
# Пример для edge-узла в локальной сети: socks5h://<IP-edge-узла>:9100
# Оставьте пустым (или закомментируйте), если сервер имеет прямой доступ к Telegram.
# PROXY=socks5h://127.0.0.1:9100

# Веб-порт для health-check (0 = отключено)
PORT=3000

# Логирование (true/false)
DEBUG=false
